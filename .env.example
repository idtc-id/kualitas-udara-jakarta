# Semua variabel bersifat opsional.

# API key ArcGIS Location Platform (untuk basemap style / layer yang butuh autentikasi)
VITE_ARCGIS_API_KEY=

# Base URL API BMKG. Default: /proxy/bmkg saat `npm run dev`, https://api.bmkg.go.id saat build.
# Isi dengan URL proxy Anda sendiri jika BMKG memblokir CORS di production.
VITE_BMKG_BASE_URL=

# Paksa memakai data contoh (mock) tanpa memanggil API apa pun: true / false
VITE_USE_MOCK_DATA=false

# Endpoint JSON data SPKU DLH DKI Jakarta (udara.jakarta.go.id) atau proxy Anda.
# Placeholder {start} dan {end} diganti timestamp ISO. Kosongkan untuk menonaktifkan.
# Sesuaikan nama field di src/providers/airquality/udaraJakarta.ts.
VITE_UDARA_JAKARTA_URL=
# Lokasi array record di dalam respons, mis. "data" atau "result.items"
VITE_UDARA_JAKARTA_RECORDS_PATH=data

# 3D object scene layer (ArcGIS Online / Enterprise) yang editable, untuk menyimpan model 3D
# yang diunggah lewat menu Tambah data (IFC, glTF/GLB, OBJ, FBX, DAE, USDZ).
# Contoh: https://services.arcgis.com/<org>/arcgis/rest/services/<nama>/SceneServer/layers/0
VITE_3D_OBJECT_LAYER_URL=

# Layanan rute bus (ArcGIS MapServer/FeatureServer). Default: Rute Transjakarta dari Jakarta Satu.
VITE_TRANSIT_SERVICE_URL=
